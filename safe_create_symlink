# shellcheck shell=bash

[ -n "${__SAFE_CREATE_SYMLINK_SOURCED:-}" ] && return
__SAFE_CREATE_SYMLINK_SOURCED=1

[[ -n "${VERBOSE:-}" ]] && echo "Loading ${BASH_SOURCE[0]} from ${BASH_SOURCE[1]}:${BASH_LINENO[0]}"

# shellcheck disable=SC1091
source "$(dirname "${BASH_SOURCE[0]}")/check_dependencies"
# shellcheck disable=SC1091
source "$(dirname "${BASH_SOURCE[0]}")/echoc"


_safe_create_symlink__set_permissions() {
	set -e

	local src; src="$(realpath -sm "$1")" || return 1
	local target; target="$(realpath -sm "$2")" || return 1

	if [[ -d "${src}" ]]; then
		chmod 700 "${target}" || return 1
		chmod -R u+rw,o-rwx "${target}" || return 1
	else
		chmod u+rw,o-rwx "${target}" || return 1
	fi

	return 0
}

safe_create_symlink() {
	local no_backup=false
	local skip_if_exists=false
	local positional_args=()

	while [[ $# -gt 0 ]]; do
		case "$1" in
			--no-backup)
				no_backup=true
				shift
				;;
			--skip-if-exists)
				skip_if_exists=true
				shift
				;;
			*)
				positional_args+=("$1")
				shift
				;;
		esac
	done

	set -- "${positional_args[@]}" # restore positional parameters


	if [[ -z "$1" ]]; then
		echoc -error "Source file/directory is missing"
		return 1
	fi
	if [[ -z "$2" ]]; then
		echoc -error "Destination file/directory is missing"
		return 1
	fi

	local src; src="$(realpath -sm "$1")" || return 1
	local target; target="$(realpath -sm "$2")" || return 1

	if [[ ! -e "$src" ]]; then
		echoc -error "Source file ${src} does not exist"
		return 1
	fi

	if $skip_if_exists && [[ -e "$target" ]]; then
		# Do nothing
		return 0
	fi

	if [[ -L "$target" || -e "$target" ]]; then
		if [[ -L "$target" && "$(readlink -f "$src")" == "$(readlink -f "$target")" ]]; then
			_safe_create_symlink__set_permissions "$src" "$target" || return 1

			echo "Link $target already exists; skipping"
			return 0
		fi

		if [[ -L "$target" && ! -e "$target" ]]; then
			echo "Deleting $target since it's a broken link"
			rm -rf "$target" || return 1
		else
			if $no_backup; then
				echo "Deleting $target"
				rm -rf "$target" || return 1
			else
				if [[ -L "${target}.orig" || -e "${target}.orig" ]]; then
					echoc -error "Backup ${target}.orig already exists; returning"
					return 1
				fi

				echo "Moving $target to ${target}.orig"
				mv "$target" "${target}.orig" || return 1
			fi
		fi
	fi

	echo "Creating link from $src to $target"
	mkdir -p "$(dirname "$target")" || return 1
	ln -sn "$src" "$target" || return 1

	_safe_create_symlink__set_permissions "$src" "$target" || return 1

	return 0
}

return 0

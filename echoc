# shellcheck shell=bash
# cSpell:disable

[ -n "${__ECHOC_SOURCED:-}" ] && return
__ECHOC_SOURCED=1

[[ -n "${VERBOSE:-}" ]] && echo "Loading ${BASH_SOURCE[0]} from ${BASH_SOURCE[1]}:${BASH_LINENO[0]}"

# shellcheck disable=SC1091
source "$(dirname "${BASH_SOURCE[0]}")/check_dependencies"

# Reference: https://gist.github.com/fnky/458719343aabd01cfb17a3a4f7296797
# https://ansi.tools/lookup
# https://terminalguide.namepad.de/attr/

declare -A _echoc__COLORS=(
	# Constants
	["-reset"]='\033[0m'
	["-nocolor"]='\033[39;49;22m'
	["-nocolorfg"]='\033[39m'
	["-nocolorbg"]='\033[49m'

	# Foreground Colors
	["-red"]='\033[0;31m'
	["-lightred"]='\033[1;31m'
	["-green"]='\033[0;32m'
	["-lightgreen"]='\033[1;32m'
	["-yellow"]='\033[1;33m'
	["-darkyellow"]='\033[0;33m' ["-orange"]='\033[0;33m'
	["-blue"]='\033[0;34m'
	["-lightblue"]='\033[1;34m'
	["-purple"]='\033[0;35m' ["-magenta"]='\033[0;35m'
	["-lightpurple"]='\033[1;35m' ["-lightmagenta"]='\033[1;35m'
	["-cyan"]='\033[0;36m'
	["-lightcyan"]='\033[1;36m'
	["-lightgray"]='\033[0;37m' ["-lightgrey"]='\033[0;37m'
	["-white"]='\033[1;37m'
	["-black"]='\033[0;30m'
	["-darkgray"]='\033[1;30m' ["-darkgrey"]='\033[1;30m'

	# Background Colors
	["-redbg"]='\033[41m'
	["-greenbg"]='\033[42m'
	["-yellowbg"]='\033[43m'
	["-bluebg"]='\033[44m'
	["-purplebg"]='\033[45m' ["-magentabg"]='\033[45m'
	["-cyanbg"]='\033[46m'
	["-whitebg"]='\033[47m'
	["-blackbg"]='\033[40m'

	# Modifiers
	["-bold"]='\033[1m' ["-bright"]='\033[1m'
	["-nobold"]='\033[22m' ["-nobright"]='\033[22m'
	["-dim"]='\033[2m' ["-faint"]='\033[2m' ["-dark"]='\033[2m'
	["-nodim"]='\033[22m' ["-nofaint"]='\033[22m' ["-nodark"]='\033[22m'
	["-italic"]='\033[3m'
	["-noitalic"]='\033[23m'
	["-underline"]='\033[4m'
	["-nounderline"]='\033[24m'
	["-doubleunderline"]='\033[4:2m'
	["-curlyunderline"]='\033[4:3m'
	["-dottedunderline"]='\033[4:4m'
	["-dashedunderline"]='\033[4:5m'
	["-blinking"]='\033[5m'
	["-noblinking"]='\033[25m'
	["-inverse"]='\033[7m' ["-reverse"]='\033[7m'
	["-noinverse"]='\033[27m' ["-noreverse"]='\033[27m'
	["-strikethrough"]='\033[9m'
	["-nostrikethrough"]='\033[29m'

	# Underline Colors
	["-redunderline"]='\033[58;5;1m'
	["-greenunderline"]='\033[58;5;2m'
	["-yellowunderline"]='\033[58;5;3m'
	["-blueunderline"]='\033[58;5;4m'
	["-purpleunderline"]='\033[58;5;5m' ["-magentaunderline"]='\033[58;5;5m'
	["-cyanunderline"]='\033[58;5;6m'
	["-whiteunderline"]='\033[58;5;7m'
	["-nounderlinecolor"]='\033[59m'
)

# Disable colors if stdout is not a TTY OR if NO_COLOR is set
if [[ ! -t 1 ]] || [[ -n "${NO_COLOR+x}" ]]; then
	for key in "${!_echoc__COLORS[@]}"; do
		_echoc__COLORS["$key"]=""
	done
fi

echoc() {
	# POSITIONAL_ARGS=()

	# while [[ $# -gt 0 ]]; do
	# 	case "$1" in
	# 		*)
	# 			POSITIONAL_ARGS+=("$1")
	# 			shift
	# 			;;
	# 	esac
	# done

	# set -- "${POSITIONAL_ARGS[@]}" # restore positional parameters


	# Variables
	local skip_newline=false
	local skip_reset=false

	for arg in "$@"; do
		local argl; argl=$(echo "$arg" | tr '[:upper:]' '[:lower:]') || return 1
		if [[ "$argl" =~ ^-[a-z0-9]+$ ]]; then
			if [[ -v _echoc__COLORS["$argl"] ]]; then
				echo -en "${_echoc__COLORS["$argl"]}"
				continue
			fi
		fi
		case $argl in
			# Special definitions
			-header|-heading) echo -en "${_echoc__COLORS["-lightblue"]}" ;; # blue
			-subheader|-subheading) echo -en "${_echoc__COLORS["-lightcyan"]}" ;; # cyan
			-error) echo -en "${_echoc__COLORS["-red"]}" ;; # red
			-warning|-warn) echo -en "${_echoc__COLORS["-darkyellow"]}" ;; # orange
			-information|-info) echo -en "${_echoc__COLORS["-nocolor"]}" ;; # nocolor
			-debug) echo -en "${_echoc__COLORS["-darkgray"]}" ;; # darkgray

			# Switches
			-n|--skip-newline) skip_newline=true ;;
			--skip-reset) skip_reset=true ;;

			# Else
			*) echo -n "$arg" ;;
		esac
	done

	if ! $skip_reset; then
		echo -en "${_echoc__COLORS["-reset"]}"
	fi

	if ! $skip_newline; then
		echo
	fi

	return 0
}

return 0
